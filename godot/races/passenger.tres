traits = "More Magicka, a little quicker and lighter on their feet. Sneak and Speech start at 20.
Less Health. People blame them: reputation rises 15% slower."
signature_ability = "Lanes-Walk"
ability_id = "lanes_walk"
signature_description = "Power (Z): for 30 seconds, while sneaking, enemies notice you at a third of the usual rate."
