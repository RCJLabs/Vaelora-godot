script = ExtResource("1_s")
id = "gravity_well"
display_name = "Gravity Well"
description = "Charge, then release: a well opens where you're aiming (up to 18 m) and drags everything within 4 m to its middle, pinned there for 6 seconds. It does no harm by itself. Stronger or weaker by the moons: strongest when Ilun is full or the Wanderer is dark."
