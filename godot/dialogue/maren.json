					"requires_not_flag": "wolves_cleared"
				},
				{
					"text": "Goodbye.",
					"next": "end"
				}
			]
		},
		"hunter_line": {
			"text": "You know your tracks. Aye, the Greyfang pack - bold enough to take a mule off the road last week. Bring me their pelts and I'll buy every one.",
